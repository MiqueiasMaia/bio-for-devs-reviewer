# --- Client-side (exposed to the browser; must be prefixed with VITE_) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key"
# (sb_publishable_...). The legacy "anon" key (a JWT) also still works here
# if your project hasn't switched to the new key format.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Server-only (Vercel Functions in /api; NEVER prefix with VITE_) ---
# Supabase dashboard -> Project Settings -> API Keys -> "Secret key"
# (sb_secret_...). The legacy "service_role" key (a JWT) also still works
# here if your project hasn't switched to the new key format. Never expose
# this value to the client — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Symmetric secret used to encrypt/decrypt each project's own AI provider
# API key (pgp_sym_encrypt/pgp_sym_decrypt) in project_ai_providers — any
# random string works; changing it makes previously-saved keys
# undecryptable, so treat it like any other secret (generate once, keep
# stable, back it up). See docs/ai-providers.md.
AI_KEY_ENCRYPTION_SECRET=a-long-random-string
# Contact email required by Unpaywall's API terms (https://unpaywall.org/products/api) —
# used only to look up legally open-access PDFs by DOI in /api/unpaywall-fetch.
UNPAYWALL_EMAIL=your-email@example.com

# --- Local tooling only (npm run db:migrate / db:seed); the app itself
# never reads this. Supabase dashboard -> Project Settings -> Database ->
# Connect -> URI (includes the database password).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
